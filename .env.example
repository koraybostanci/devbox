# Personal dev environment — copy this to .env and fill in your values.
# .env is gitignored; this file is committed as documentation.
# Values must be JSON-compatible double-quoted strings.
#
# Usage: devbox init, edit .env, then devbox init again.

# Git identity inside the VM (does not touch host gitconfig)
export GIT_NAME="Your Name"
export GIT_EMAIL="you@personal.com"

# Databricks workspace (optional — authenticate with: devbox databricks login)
export DATABRICKS_HOST=""

# Bundled service credentials
export POSTGRES_USER="dev"
export POSTGRES_PASSWORD="devpass"
export POSTGRES_DB="dev"
export POSTGRES_PORT="15432"

# Optional VM resources and Mac-backed storage locations
export DEVBOX_CPU="4"
export DEVBOX_MEMORY="4"
export DEVBOX_DISK="60"
# export DEVBOX_PROJECTS_DIR="/absolute/path/to/projects"
# export DEVBOX_DATA_DIR="/absolute/path/to/data"

# Experimental isolation POC only. These must be explicitly set before running
# `devbox isolation-poc`; see docs/isolation-poc.md for firewall/VLAN prerequisites.
# export DEVBOX_ISOLATION_POC_INTERFACE="en0"
# export DEVBOX_ISOLATION_POC_DNS="1.1.1.1,1.0.0.1"
# export DEVBOX_ISOLATION_POC_DENY_TARGETS="10.0.0.10:443"
