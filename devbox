#!/bin/bash
# Usage: ./devbox <command>

set -Eeuo pipefail

DEVBOX_SCRIPT="$0"
while [ -L "$DEVBOX_SCRIPT" ]; do
    SCRIPT_LINK_DIR="$(cd -P "$(dirname "$DEVBOX_SCRIPT")" && pwd)"
    DEVBOX_SCRIPT="$(readlink "$DEVBOX_SCRIPT")"
    case "$DEVBOX_SCRIPT" in
        /*) ;;
        *) DEVBOX_SCRIPT="$SCRIPT_LINK_DIR/$DEVBOX_SCRIPT" ;;
    esac
done
DEVBOX_SCRIPT="$(cd -P "$(dirname "$DEVBOX_SCRIPT")" && pwd)/$(basename "$DEVBOX_SCRIPT")"
BOOTSTRAP_DIR="$(dirname "$DEVBOX_SCRIPT")"
source "$BOOTSTRAP_DIR/lib/common.sh"

DEVBOX_DIR="$(dirname "$DEVBOX_SCRIPT")"
source "$DEVBOX_DIR/lib/config.sh"
source "$DEVBOX_DIR/lib/devbox.sh"

usage() {
    cat <<'EOF'
Usage: devbox <command> [options]

Get started:
    init                           Initialize configuration and install the devbox command

Daily workflow:
    start                          Start and converge the VM
    connect                        Open a guest zsh shell
    exec <command> [args...]       Run one command in the guest
    status                         Show VM state and resources
    stop [--force]                 Stop gracefully; force only when requested

Services:
    services start                 Start the managed PostgreSQL and Valkey services
    services stop                  Stop them (data is kept)
    services status                Show the managed PostgreSQL and Valkey services

Authentication and helpers (optional, guest-local):
    auth status                    Show per-provider authentication state
    auth login <provider>          Authenticate github, claude, opencode, databricks
    db info                        Show PostgreSQL connection settings

Maintenance:
    provision                      Force non-destructive provisioning
    destroy                        Remove the VM and its container runtime data
    uninstall                      Remove the devbox command symlink

Other:
    version                        Show the devbox version
    help                           Show this help message

Typical workflow:
    devbox init
    devbox start
    devbox connect
    devbox stop
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
    help | --help | -h)
        usage
        exit 0
        ;;
    uninstall)
        [ $# -eq 0 ] || die "Usage: devbox uninstall"
        uninstall_cli "$DEVBOX_SCRIPT"
        ;;
    version)
        [ $# -eq 0 ] || die "Usage: devbox version"
        version_file="$DEVBOX_DIR/VERSION"
        if [ -f "$version_file" ]; then
            version="$(cat "$version_file")"
            version="${version#"${version%%[![:space:]]*}"}"
            version="${version%"${version##*[![:space:]]}"}"
            printf '%s\n' "$version"
        else
            version="$(git -C "$DEVBOX_DIR" describe --tags --always --dirty 2>/dev/null || true)"
            printf '%s\n' "${version:-unknown}"
        fi
        ;;
    init)
        [ $# -eq 0 ] || die "Usage: devbox init"
        # Install the command first so even the first run leaves the user able
        # to use `devbox` instead of `./devbox`.
        install_cli "$DEVBOX_SCRIPT"
        initialize_local_config
        ;;
    start | provision | connect | exec | status | services | auth | db | stop | destroy)
        run_devbox "$cmd" "$@"
        ;;
    *)
        [ -n "$cmd" ] && echo "Unknown command: $cmd" && echo ""
        usage
        exit 1
        ;;
esac
